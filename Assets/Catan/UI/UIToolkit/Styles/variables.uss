/*
 * Catan Design Tokens — REFERENCE ONLY
 *
 * CSS custom properties (var()) do not work reliably in Unity 6 USS.
 * All values below are inlined directly into the USS files that use them.
 *
 * Colors
 *   bg-panel            rgba(20, 18, 14, 0.88)
 *   bg-panel-light      rgba(38, 34, 26, 0.92)
 *   bg-overlay          rgba(0, 0, 0, 0.72)
 *   bg-button           rgba(60, 52, 36, 1)
 *   bg-button-hover     rgba(88, 76, 52, 1)
 *   bg-button-active    rgba(112, 96, 64, 1)
 *   bg-button-disabled  rgba(36, 34, 30, 1)
 *   text-primary        rgba(240, 228, 196, 1)
 *   text-secondary      rgba(180, 164, 128, 1)
 *   text-disabled       rgba(100, 96, 86, 1)
 *   text-highlight      rgba(255, 220, 80, 1)
 *   accent-gold         rgba(212, 172, 60, 1)
 *   accent-selected     rgba(255, 220, 80, 1)
 *   border              rgba(90, 78, 52, 1)
 *   border-focus        rgba(212, 172, 60, 1)
 *   card-playable       rgba(51, 140, 51, 1)
 *   card-unplayable     rgba(76, 76, 76, 1)
 *
 * Spacing: xs=4px  sm=8px  md=12px  lg=20px  xl=32px
 * Radius:  sm=4px  md=8px  lg=14px
 * Font:    xs=10px sm=12px md=14px  lg=18px  xl=24px  hero=36px
 * Border:  width=1px  focus=2px
 * Modal:   width=360px
 */
