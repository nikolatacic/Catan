/* ── Base resets ──────────────────────────────────────────────────────────── */

.unity-label {
    color: rgba(240, 228, 196, 1);
    -unity-font-style: normal;
    padding: 0;
    margin: 0;
}

/* ── Panels ───────────────────────────────────────────────────────────────── */

.panel {
    background-color: rgba(20, 18, 14, 0.88);
    border-color: rgba(90, 78, 52, 1);
    border-width: 1px;
    border-radius: 8px;
    padding: 12px;
}

.panel--light {
    background-color: rgba(38, 34, 26, 0.92);
}

.panel--overlay {
    background-color: rgba(0, 0, 0, 0.72);
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.modal {
    background-color: rgba(20, 18, 14, 0.88);
    border-color: rgba(212, 172, 60, 1);
    border-width: 2px;
    border-radius: 14px;
    padding: 20px;
    width: 360px;
    align-items: stretch;
}

/* ── Buttons ──────────────────────────────────────────────────────────────── */

.btn {
    background-color: rgba(60, 52, 36, 1);
    border-color: rgba(90, 78, 52, 1);
    border-width: 1px;
    border-radius: 4px;
    color: rgba(240, 228, 196, 1);
    -unity-font-style: bold;
    font-size: 12px;
    padding: 8px 12px;
    margin: 4px;
    transition-duration: 0.1s;
    transition-property: background-color, border-color;
}

.btn:hover {
    background-color: rgba(88, 76, 52, 1);
    border-color: rgba(212, 172, 60, 1);
}

.btn:active {
    background-color: rgba(112, 96, 64, 1);
}

.btn:disabled {
    background-color: rgba(36, 34, 30, 1);
    color: rgba(100, 96, 86, 1);
    border-color: rgba(36, 34, 30, 1);
}

.btn--primary {
    background-color: rgba(212, 172, 60, 1);
    border-color: rgba(212, 172, 60, 1);
    color: rgba(20, 18, 14, 1);
}

.btn--primary:hover {
    background-color: rgba(240, 196, 72, 1);
}

.btn--danger {
    background-color: rgba(140, 44, 28, 1);
    border-color: rgba(180, 60, 40, 1);
}

.btn--danger:hover {
    background-color: rgba(180, 60, 40, 1);
}

.btn--selected {
    background-color: rgba(255, 220, 80, 1);
    border-color: rgba(212, 172, 60, 1);
    color: rgba(20, 18, 14, 1);
}

/* ── Resource buttons (5-slot rows) ──────────────────────────────────────── */

.resource-btn {
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: rgba(60, 52, 36, 1);
    border-color: rgba(90, 78, 52, 1);
    border-width: 1px;
    border-radius: 4px;
    padding: 8px;
    margin: 4px;
    min-width: 56px;
    min-height: 64px;
}

.resource-btn:hover {
    border-color: rgba(212, 172, 60, 1);
}

.resource-btn--selected {
    border-color: rgba(255, 220, 80, 1);
    border-width: 2px;
    background-color: rgba(80, 68, 40, 1);
}

.resource-btn--disabled {
    opacity: 0.35;
}

/* ── Typography helpers ───────────────────────────────────────────────────── */

.label--xs        { font-size: 10px; color: rgba(180, 164, 128, 1); }
.label--sm        { font-size: 12px; color: rgba(240, 228, 196, 1); }
.label--md        { font-size: 14px; color: rgba(240, 228, 196, 1); }
.label--lg        { font-size: 18px; color: rgba(240, 228, 196, 1); -unity-font-style: bold; }
.label--xl        { font-size: 24px; color: rgba(240, 228, 196, 1); -unity-font-style: bold; }
.label--hero      { font-size: 36px; color: rgba(212, 172, 60, 1);  -unity-font-style: bold; }
.label--highlight { color: rgba(255, 220, 80, 1); }
.label--secondary { color: rgba(180, 164, 128, 1); }
.label--disabled  { color: rgba(100, 96, 86, 1); }

/* ── Layout helpers ───────────────────────────────────────────────────────── */

.row {
    flex-direction: row;
    align-items: center;
}

.row--space-between {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.col {
    flex-direction: column;
}

.gap-xs { margin: 4px; }
.gap-sm { margin: 8px; }
.gap-md { margin: 12px; }

.divider {
    height: 1px;
    background-color: rgba(90, 78, 52, 1);
    margin-top: 8px;
    margin-bottom: 8px;
}

.hidden {
    display: none;
}
