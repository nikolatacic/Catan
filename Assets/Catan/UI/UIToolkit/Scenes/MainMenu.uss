
.main-menu-root {
    flex: 1;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.72);
}

.title-block {
    align-items: center;
    margin-bottom: 32px;
}

.title-label {
    letter-spacing: 6px;
    margin-bottom: 8px;
}

.button-block {
    align-items: stretch;
    width: 260px;
}

.menu-btn {
    width: 100%;
    height: 48px;
    font-size: 14px;
    margin-bottom: 8px;
    justify-content: center;
}
