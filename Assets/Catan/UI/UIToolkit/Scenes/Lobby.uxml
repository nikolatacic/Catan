<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="project://database/Assets/Catan/UI/UIToolkit/Styles/variables.uss"/>
    <ui:Style src="project://database/Assets/Catan/UI/UIToolkit/Styles/common.uss"/>
    <ui:Style src="project://database/Assets/Catan/UI/UIToolkit/Scenes/Lobby.uss"/>

    <!-- Root overlay; hidden by default, shown by MainMenuView on Host/Join -->
    <ui:VisualElement name="LobbyRoot" class="panel--overlay lobby-overlay" style="display: none;">

        <ui:VisualElement name="LobbyModal" class="modal lobby-modal">

            <ui:Label name="LobbyTitle" text="Multiplayer Lobby" class="label--lg lobby-title"/>

            <ui:VisualElement class="divider"/>

            <!-- Host section: visible when hosting -->
            <ui:VisualElement name="HostSection" class="lobby-section" style="display: none;">
                <ui:Label text="Join Code" class="label--xs label--secondary"/>
                <ui:Label name="JoinCodeDisplay" text="—" class="label--xl join-code-display"/>
                <ui:Label text="Share this code with other players." class="label--xs label--secondary"/>
            </ui:VisualElement>

            <!-- Client section: visible when joining -->
            <ui:VisualElement name="ClientSection" class="lobby-section" style="display: none;">
                <ui:Label text="Enter Join Code" class="label--xs label--secondary"/>
                <ui:TextField name="JoinCodeInput" class="join-code-input"/>
            </ui:VisualElement>

            <ui:VisualElement class="divider"/>

            <ui:Label name="StatusLabel" text="" class="label--sm label--secondary status-label"/>

            <ui:VisualElement name="ButtonRow" class="row lobby-button-row">
                <ui:Button name="BackButton" text="Back" class="btn lobby-btn"/>
                <ui:Button name="ConfirmButton" text="Confirm" class="btn btn--primary lobby-btn"/>
            </ui:VisualElement>

        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
