
.lobby-overlay {
    background-color: rgba(0, 0, 0, 0.72);
}

.lobby-modal {
    min-width: 340px;
    max-width: 420px;
}

.lobby-title {
    margin-bottom: 8px;
    -unity-text-align: upper-center;
}

.lobby-section {
    flex-direction: column;
    margin-top: 8px;
    margin-bottom: 8px;
}

.join-code-display {
    color: rgba(212, 172, 60, 1);
    -unity-text-align: upper-center;
    letter-spacing: 4px;
    margin-top: 4px;
    margin-bottom: 4px;
}

.join-code-input {
    margin-top: 4px;
    height: 36px;
    font-size: 14px;
    color: rgba(240, 228, 196, 1);
    background-color: rgba(60, 52, 36, 1);
    border-color: rgba(90, 78, 52, 1);
    border-width: 1px;
    border-radius: 4px;
    padding: 4px 8px;
}

.join-code-input:focus {
    border-color: rgba(212, 172, 60, 1);
    border-width: 2px;
}

.status-label {
    min-height: 20px;
    margin-top: 8px;
    -unity-text-align: upper-center;
    white-space: normal;
}

.lobby-button-row {
    margin-top: 12px;
    justify-content: flex-end;
}

.lobby-btn {
    min-width: 100px;
    height: 40px;
    justify-content: center;
}
