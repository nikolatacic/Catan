
/* ── Root overlay ─────────────────────────────────────────────────────────── */

.hud-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}


/* ── Right panel ──────────────────────────────────────────────────────────── */

.right-panel {
    position: absolute;
    top: 8px;
    right: 8px;
    bottom: 72px;
    width: 220px;
    flex-direction: column;
    overflow: hidden;
}

.hud-section {
    margin-bottom: 8px;
}

.section-title {
    margin-bottom: 4px;
    letter-spacing: 1px;
}

/* Turn indicator */

.turn-header {
    margin-bottom: 8px;
    align-items: flex-start;
}

.player-color-bar {
    width: 6px;
    min-height: 36px;
    border-radius: 3px;
    margin-right: 8px;
    background-color: rgba(212, 172, 60, 1);
}

.turn-header-labels {
    flex: 1;
}

.phase-label {
    margin-top: 4px;
    white-space: normal;
}

.dice-label {
    margin-top: 4px;
    -unity-text-align: upper-center;
    min-height: 0;
}

/* Summary rows (created at runtime by AllPlayersSummaryView) */

.summary-row-container {
    flex-direction: column;
}

/* Dev card hand */

.dev-card-container {
    flex-direction: column;
}

.dev-empty-label {
    margin-top: 4px;
    -unity-text-align: upper-center;
}

/* ── Player hand ──────────────────────────────────────────────────────────── */

.player-hand-section {
    position: absolute;
    bottom: 72px;
    left: 8px;
    flex-direction: column;
    min-width: 280px;
}

.hand-header {
    margin-bottom: 8px;
}

.resource-row {
    flex-direction: row;
    align-items: flex-end;
}

.resource-slot {
    flex-direction: column;
    align-items: center;
    margin-right: 4px;
    min-width: 48px;
}

.resource-card-icon {
    width: 40px;
    height: 56px;
    border-radius: 4px;
    background-color: rgba(60, 52, 36, 1);
    background-size: cover;
    background-position: center;
}

.resource-count-label {
    font-size: 12px;
    color: rgba(240, 228, 196, 1);
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    margin-top: 2px;
}

/* ── Cheat menu ───────────────────────────────────────────────────────────── */

.cheat-section {
    position: absolute;
    top: 8px;
    left: 8px;
    flex-direction: column;
    align-items: flex-start;
}

.cheat-toggle-btn {
    font-size: 10px;
    padding: 2px 6px;
    opacity: 0.6;
}

.cheat-panel {
    margin-top: 4px;
    min-width: 140px;
    flex-direction: column;
}

/* ── Action bar ───────────────────────────────────────────────────────────── */

.action-bar {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 64px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    background-color: rgba(20, 18, 14, 0.88);
    border-top-color: rgba(90, 78, 52, 1);
    border-top-width: 1px;
    padding: 0 8px;
}

.action-btn {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 4px 8px;
    min-width: 56px;
    height: 52px;
    margin: 2px;
}

.action-btn-icon {
    width: 24px;
    height: 24px;
    background-size: contain;
    background-position: center;
    margin-bottom: 2px;
}

.action-btn-label {
    font-size: 10px;
    color: rgba(240, 228, 196, 1);
    -unity-text-align: upper-center;
    white-space: nowrap;
}

.action-btn--turn {
    border-color: rgba(212, 172, 60, 1);
}

.action-btn--build {
    min-width: 64px;
}

.action-btn--trade {
    min-width: 80px;
}

.action-separator {
    width: 1px;
    height: 40px;
    background-color: rgba(90, 78, 52, 1);
    margin: 0 4px;
}

/* ── Runtime-spawned elements (AllPlayersSummaryView, DevHandView) ────────── */

/* PlayerSummaryRow elements */
.summary-row {
    flex-direction: row;
    align-items: center;
    padding: 4px 0;
    border-bottom-color: rgba(90, 78, 52, 1);
    border-bottom-width: 1px;
}

.summary-row-color-bar {
    width: 4px;
    height: 100%;
    min-height: 28px;
    border-radius: 2px;
    margin-right: 4px;
}

.summary-row-active-dot {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background-color: rgba(212, 172, 60, 1);
    margin-right: 4px;
}

.summary-row-name {
    flex: 1;
    font-size: 12px;
    color: rgba(240, 228, 196, 1);
    white-space: nowrap;
    overflow: hidden;
}

.summary-row-name--active {
    -unity-font-style: bold;
    color: rgba(212, 172, 60, 1);
}

.summary-row-stats {
    flex-direction: row;
    align-items: center;
}

.summary-row-stat {
    font-size: 10px;
    color: rgba(180, 164, 128, 1);
    margin-left: 4px;
}

.summary-row-badge {
    font-size: 8px;
    color: rgba(212, 172, 60, 1);
    margin-left: 2px;
}

/* DevCardItem elements */
.dev-card-item {
    flex-direction: row;
    align-items: center;
    padding: 4px;
    border-radius: 4px;
    margin-bottom: 2px;
}

.dev-card-item--playable {
    background-color: rgba(51, 140, 51, 1);
}

.dev-card-item--unplayable {
    background-color: rgba(76, 76, 76, 1);
    opacity: 0.7;
}

.dev-card-icon {
    width: 28px;
    height: 40px;
    background-size: contain;
    background-position: center;
    margin-right: 4px;
    border-radius: 2px;
}

.dev-card-name {
    flex: 1;
    font-size: 10px;
    color: rgba(240, 228, 196, 1);
}

.dev-card-play-btn {
    font-size: 10px;
    padding: 2px 6px;
    min-width: 36px;
}
