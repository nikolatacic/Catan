/* ── Overlay backdrop ─────────────────────────────────────────────── */
.modal-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.65);
}

/* ── Modal card ───────────────────────────────────────────────────── */
.bank-trade-modal,
.discard-modal,
.resource-picker-modal,
.steal-modal,
.victory-modal {
    min-width: 360px;
    max-width: 520px;
    padding: 20px;
    padding-bottom: 32px;
    border-radius: 8px;
    background-color: rgba(20, 18, 14, 0.88);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    flex-direction: column;
    align-items: stretch;
}

.modal-title {
    align-self: center;
    margin-bottom: 6px;
    -unity-font-style: bold;
    white-space: normal;
    -unity-text-align: upper-center;
}

.section-title {
    margin-top: 8px;
    margin-bottom: 4px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgba(180, 164, 128, 1);
}

/* ── Resource rows ────────────────────────────────────────────────── */
.bank-resource-row {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 4px;
    margin-bottom: 4px;
}

/* Card-shaped icon inside each resource button */
.bank-card-icon {
    width: 44px;
    height: 62px;
    margin-bottom: 4px;
    -unity-background-scale-mode: scale-to-fit;
    align-self: center;
}

/* Override resource-btn for the narrower bank layout */
.bank-trade-modal .resource-btn,
.resource-picker-modal .resource-btn {
    min-width: 68px;
    padding: 4px;
    flex-direction: column;
    align-items: center;
}

.modal-feedback {
    align-self: center;
    margin-top: 8px;
    color: rgba(180, 164, 128, 1);
    white-space: normal;
    -unity-text-align: upper-center;
}

/* ── Bottom button row ───────────────────────────────────────────── */
.modal-button-row {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 12px;
}

.modal-btn {
    min-width: 88px;
    margin-left: 8px;
}

.modal-btn-full {
    width: 100%;
    margin-top: 12px;
}

/* ── Discard panel ────────────────────────────────────────────────── */
.discard-modal {
    max-width: 600px;
}

.discard-card-area {
    flex-direction: row;
    flex-wrap: nowrap;
    min-height: 90px;
    max-height: 92px;
    border-radius: 4px;
    background-color: rgba(0, 0, 0, 0.2);
    padding: 6px;
    margin-bottom: 6px;
}

.discard-selected-area {
    background-color: rgba(180, 40, 40, 0.12);
    border-width: 1px;
    border-color: rgba(220, 60, 60, 0.35);
}

/* Each discard card widget */
.discard-card {
    width: 52px;
    height: 74px;
    margin-right: 4px;
    border-radius: 4px;
    -unity-background-scale-mode: scale-to-fit;
}

.discard-card:hover {
    border-color: rgba(255, 220, 80, 1);
    border-width: 1px;
}

/* ── Steal panel ──────────────────────────────────────────────────── */
.steal-button-container {
    flex-direction: column;
    align-items: stretch;
}

.steal-player-btn {
    flex-direction: row;
    align-items: center;
    padding: 8px 12px;
    margin-bottom: 4px;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    background-color: rgba(255, 255, 255, 0.04);
    font-size: 14px;
    color: rgba(240, 228, 196, 1);
}

.steal-player-btn:hover {
    background-color: rgba(255, 255, 255, 0.1);
}

.steal-player-color-swatch {
    width: 14px;
    height: 14px;
    border-radius: 7px;
    margin-right: 8px;
}

/* ── Victory screen ───────────────────────────────────────────────── */
.victory-overlay {
    background-color: rgba(0, 0, 0, 0.75);
}

.victory-modal {
    align-items: center;
    text-align: center;
}

.victory-color-bar {
    width: 120px;
    height: 6px;
    border-radius: 3px;
    margin-top: 4px;
    margin-bottom: 8px;
}
